        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:?plugin root is required}}/hooks/session-start.mjs\""
          }
        ]
      }
    ]
  }
}
